# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is excluded by .gitignore.

# ─────────────────────────────────────────────────────────────
# Groq API Key  (required only for the AI Assistant tab)
# ─────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
#   → Sign up → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use.
# Verify currently available models at: https://console.groq.com/docs/models
# Examples: llama-3.1-8b-instant  |  llama3-8b-8192  |  gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# ─────────────────────────────────────────────────────────────
# Server settings  (optional — defaults shown)
# ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed CORS origins (localhost only by default)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
